{
	"name": "daily-carryover",
	"version": "0.1.0",
	"description": "Obsidian plugin that starts each new daily note as a verbatim copy of the most recent earlier one.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"deploy": "npm run build && node scripts/deploy.mjs"
	},
	"license": "0BSD",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"moment": "2.29.4",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"vitest": "^3.2.4"
	}
}
